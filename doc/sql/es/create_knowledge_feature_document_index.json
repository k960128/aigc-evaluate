{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": false,
    "properties": {
      "documentId": {
        "type": "text"
      },
      "riskDetailsId": {
        "type": "long"
      },
      "categoryId": {
        "type": "long"
      },
      "featureText": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 2048
          }
        }
      },
      "normalizedText": {
        "type": "text",
        "analyzer": "ik_max_word",
        "search_analyzer": "ik_smart",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 2048
          }
        }
      },
      "polarity": {
        "type": "keyword",
        "ignore_above": 64
      },
      "source": {
        "type": "keyword",
        "ignore_above": 128
      },
      "threshold": {
        "type": "scaled_float",
        "scaling_factor": 1000
      },
      "contentHash": {
        "type": "keyword",
        "ignore_above": 128
      },
      "currentVersion": {
        "type": "integer"
      },
      "currentVersionId": {
        "type": "long"
      },
      "status": {
        "type": "integer"
      },
      "createTime": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis"
      },
      "updateTime": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||strict_date_optional_time||epoch_millis"
      }
    }
  }
}